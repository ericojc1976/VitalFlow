[app]
title = VitalFlow
package.name = vitalflow
package.domain = org.vitalflow
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1.0
requirements = python3,flet
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,ACCESS_FINE_LOCATION,BODY_SENSORS
android.api = 31
android.minapi = 21
android.ndk = 25b
android.accept_sdk_license = True
log_level = 2
warn_on_root = 1
